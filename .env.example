APP_NAME=AquaSecure
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=aquasecure
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# ─── E-mail ───────────────────────────────────────────────────────────────────
# ⚠️ ATTENTION : "MAIL_MAILER=log" N'ENVOIE AUCUN E-MAIL.
# Les messages sont écrits dans storage/logs/laravel.log au lieu d'être
# expédiés. Aucune erreur n'est levée : les notifications (demande acceptée,
# demandée refusée, paiement confirmé) semblent alors partir alors qu'elles
# ne le font jamais.
#
# Pour recevoir réellement les e-mails en local, passez à smtp et renseignez
# vos identifiants (jamais ceux-ci dans ce fichier, jamais dans Git) :
#
#   MAIL_MAILER=smtp
#   MAIL_SCHEME=smtps            # Gmail : port 465 => smtps (PAS tls, qui
#                                 # lève UnsupportedSchemeException)
#   MAIL_HOST=smtp.gmail.com
#   MAIL_PORT=465
#   MAIL_USERNAME=
#   MAIL_PASSWORD=               # mot de passe d'application Gmail
#
# Les tests ne sont pas concernés : phpunit.xml force MAIL_MAILER=array.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# ─── JWT Security ──────────────────────────────────────────────────────────────
# Generate with: php artisan jwt:secret
# NEVER commit a real value here — .env must be in .gitignore
JWT_SECRET=
# Access token lifetime in minutes (default: 60)
JWT_TTL=60
# Refresh TTL in minutes — used by tymon blacklist (DB refresh tokens use 7 days hardcoded in JwtAuthController)
JWT_REFRESH_TTL=10080
# Algorithm: HS256 (default for single-server; use RS256 for multi-service architectures)
JWT_ALGO=HS256

# Google OAuth (Laravel Socialite)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# Google reCAPTCHA v2
RECAPTCHA_ENABLED=true
RECAPTCHA_VERSION=v2
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_MIN_SCORE=0.5

# ── Paiement simulé (usage académique) ───────────────────────────────────────
# Aucune passerelle de paiement externe n'est utilisée, aucun appel réseau n'est
# effectué et aucun argent réel n'est transféré. Le résultat est produit
# localement par App\Services\Payments\SimulatedPaymentProvider.
#
# PAYMENT_DRIVER accepte uniquement "simulated". Toute autre valeur est refusée
# au démarrage afin qu'aucun paiement réel ne puisse jamais être activé.
PAYMENT_DRIVER=simulated

# Permet au citoyen de choisir le scénario (succès / refus / erreur) sur la page
# de récapitulatif. STRICTEMENT réservé au développement et aux démonstrations :
# en production cette valeur doit rester "false", le résultat est alors toujours
# un succès puisqu'aucun risque financier n'existe.
PAYMENT_SIMULATION_SCENARIO_CHOICE=true

# ─── Chatbot IA (Projets et Financements) ─────────────────────────────────────
# Fournisseur LLM : Grok via Groq Cloud (API compatible OpenAI).
# Obtenez votre clé sur https://console.groq.com/ — NE JAMAIS committer
# une vraie clé, et ne jamais l'inscrire directement ici.
CHATBOT_ENABLED=true
CHATBOT_LLM_PROVIDER=groq
GROK_API_KEY=
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT=30

CHATBOT_MAX_MESSAGE_LENGTH=2000
CHATBOT_MAX_TOOL_CALLS=3
CHATBOT_RATE_LIMIT=10

CHATBOT_RAG_ENABLED=true
CHATBOT_MAX_RAG_CHUNKS=5
