APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

JWT_SECRET=
JWT_AUDIENCE=aquasecure-api
JWT_TTL=60
JWT_REFRESH_TTL=10080
JWT_ALGO=HS256

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
 DB_HOST=127.0.0.1
 DB_PORT=3306
 DB_DATABASE=laravel
 DB_USERNAME=root
 DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ─── Google Gemini (Google AI Studio) ─────────────────────────────────────────
# Create a key at https://aistudio.google.com/app/apikey — never commit the real value
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT=30
GEMINI_CACHE_MINUTES=360

# ─── JWT Security ──────────────────────────────────────────────────────────────
# Generate with: php artisan jwt:secret
# NEVER commit a real value here — .env must be in .gitignore
JWT_SECRET=
# Access token lifetime in minutes (default: 60)
JWT_TTL=60
# Refresh TTL in minutes — used by tymon blacklist (DB refresh tokens use 7 days hardcoded in JwtAuthController)
JWT_REFRESH_TTL=10080
# Algorithm: HS256 (default for single-server; use RS256 for multi-service architectures)
JWT_ALGO=HS256
# Optional LLM explanation for infrastructure failure-risk factors
FAILURE_RISK_AI_API_KEY=
FAILURE_RISK_AI_MODEL=gpt-4o-mini
FAILURE_RISK_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
FAILURE_RISK_AI_TIMEOUT=5

# Optional LLM recommendation for infrastructure failure-risk
RECOMMENDATION_AI_API_KEY=
RECOMMENDATION_AI_MODEL=gpt-4o-mini
RECOMMENDATION_AI_ENDPOINT=https://api.openai.com/v1/chat/completions
RECOMMENDATION_AI_TIMEOUT=8
